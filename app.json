{
  "expo": {
    "name": "bk_fitness_tracker",
    "slug": "bk_fitness_tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bkf_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/bkf_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/bkf_logo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/bkf_logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to let you share them with your friends.",
          "cameraPermission": "The app needs access to your camera to let you take photos and videos."
        }
      ]
    ]
  }
}